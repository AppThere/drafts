<?xml version="1.0" encoding="utf-8"?>
<!--
  appthere-drafts.md 9.2, and 7.2's task-per-document.

  Three traps 9.2 states plainly, all of them visible here:

  - Downloads and messaging apps hand over application/octet-stream whatever the file is, so there
    is a permissive filter matched on extension as well as the MIME filters, and DocumentActivity
    sniffs the contents when neither answers.
  - pathPattern has no alternation and matches greedily from the start, so there is one <data>
    element per extension rather than one clever one. `.*\\.md` also matches notes.mdx, which is why
    DocumentKind validates the name after receiving it rather than trusting the filter.
  - takePersistableUriPermission is called at open, in androidIdentity, or session restore fails
    silently on the next launch.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!--
          7.2: "Give the document Activity android:launchMode='standard',
          android:documentLaunchMode='intoExisting', and android:resizeableActivity='true'."

          documentLaunchMode is what gives each document its own task: Android keys the task on the
          intent's data, so one URI is one entry in Recents and two can be dragged into
          split-screen against each other. That is what makes side by side work on tablets,
          foldables and ChromeOS.

          There is no per-document taskAffinity here, despite the plan naming one. taskAffinity is
          a manifest attribute, one string for every launch, and an Activity cannot vary it at
          runtime; it cannot express "a task per document" at all. documentLaunchMode can, and
          does. What the document contributes per launch is its name, through TaskDescription.
        -->
        <!--
          configChanges, so that resizing a window does not restart the document.

          Android recreates an Activity on a configuration change by default, and entering or
          leaving split-screen is one, as is rotating the device. Measured on an emulator: type a
          word, rotate, and the word is gone. What came back was 8.3's snapshot, which is written
          three seconds after an edit, so every rotation cost whatever had been typed since the
          last one and reset the caret and the undo history with it.

          Compose resizes without being restarted, so handling these is the fix rather than a
          workaround. It does not cover process death, and is not meant to: that is what 8.1's
          snapshot and 8.3's recovery are for, and they work.
        -->
        <activity
            android:name=".DocumentActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode|fontScale|layoutDirection"
            android:documentLaunchMode="intoExisting"
            android:exported="true"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">

            <!--
              9.1's registered type, the unregistered spelling several editors send, and the two
              types a handover uses when it is not saying what the file really is.

              text/plain is what Drive and most mail clients call a document they cannot name, and
              what Fountain always arrives as: 9.1 says Fountain has no registered MIME type at all.

              application/octet-stream is 9.2's first trap stated plainly: "Downloads and messaging
              apps frequently hand over application/octet-stream regardless of the real type." The
              extension filter below catches those whose URI carries a name; a mail attachment's
              does not, so without this one a .md attachment reaches nothing. Measured on a device:
              before this filter existed, a Gmail-shaped and a Drive-shaped handover both resolved
              to no activity at all.

              The cost is that every unknown binary on the device can now be pointed at Drafts.
              DocumentKind.looksLikeText is what says no to those, before anything is opened.
            -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!--
              Extension matching, for the types with no registered MIME and the senders that
              volunteer the wrong one. One <data> per extension: pathPattern has no alternation.
            -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="*" android:mimeType="*/*" android:scheme="content" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
                <data android:pathPattern=".*\\.mdown" />
                <data android:pathPattern=".*\\.mkd" />
                <data android:pathPattern=".*\\.fountain" />
                <data android:pathPattern=".*\\.spmd" />
            </intent-filter>

            <!--
              9.2's share sheet. The document arrives as EXTRA_STREAM rather than as data, and a
              messaging app sharing an attachment names its type as vaguely as it sent it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          7.4's launcher entry, and the two app shortcuts beside it.

          It shows nothing and finishes immediately: it decides what this launch opens and starts a
          DocumentActivity task for each. The translucent theme is what keeps that invisible — with
          an ordinary one the reader would see a blank window of this application appear and be
          replaced, every launch.

          excludeFromRecents, because it is not a document and 7.2 gives Recents to documents.
          noHistory, so Back from a document goes where the reader came from rather than to a blank
          screen this Activity left behind.
        -->
        <activity
            android:name=".LauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
